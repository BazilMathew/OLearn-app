# Copy to .env (git-ignored) and fill in. Read by the server in /server only.

# OpenAI key for Whisper speech-to-text and Ask Me routing.
# If empty, /api/stt and /api/route return 503 and the app uses on-device matching.
OPENAI_API_KEY=

# Port for the API server. Default: 3001
PORT=

# Browser origin allowed by CORS, e.g. the URL the app is served from.
# If empty, no cross-origin requests are allowed (the Vite dev proxy still works).
CLIENT_ORIGIN=
